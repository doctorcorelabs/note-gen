# Contoh variabel environment untuk API Fastify di server/ (lockfile terpisah, Postgres 17).
# DUMMY SAJA. Jangan isi nilai nyata di file ini.
# Salin ke server/.env untuk pemakaian lokal, lalu isi nilai nyata di server/.env (tidak pernah di-commit).
# Hanya variabel Bagian A yang dibaca kode server Fase 0 (endpoint health).
# Variabel Bagian B adalah placeholder rencana fase berikutnya dari draf hygiene W09;
# kode Fase 0 belum membacanya. Jangan menganggap Bagian B aktif sebelum kodenya ada.
# Perilaku start: hanya PORT yang tidak valid yang menggagalkan start.
# DATABASE_URL atau WORKSPACE_ROOT yang hilang tidak menggagalkan start;
# server tetap start, live menjawab 200, dan ready menjawab 503.

# Bagian A: dibaca kode server Fase 0.

NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# Timeout health dalam milidetik. Batas total harus lebih besar dari timeout per check.
HEALTH_CHECK_TIMEOUT_MS=2000
HEALTH_OVERALL_TIMEOUT_MS=5000

# Koneksi Postgres 17. User, password, dan nama database harus cocok dengan infra/.env
# pada deployment yang sama. Nilai di bawah ini dummy; ganti seluruhnya di server/.env.
# Bila tidak di-set, ready menjawab 503 (db: DB_NOT_CONFIGURED).
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/CHANGE_ME_DB

# Root penyimpanan file workspace di disk server. Harus path absolut dan bukan /.
# Nama kanonis: WORKSPACE_ROOT, tanpa fallback ke nama lain.
# Bila tidak di-set, ready menjawab 503 (workspace: WORKSPACE_NOT_CONFIGURED).
WORKSPACE_ROOT=/CHANGE_ME/workspace

# Bagian B: rencana fase berikutnya (draf hygiene W09). Belum dibaca kode Fase 0.

# Secret penandatanganan token dan penyegelan data. Minimal 32 karakter acak.
# Jangan pernah diganti setelah layanan berjalan tanpa prosedur rotasi.
AUTH_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARACTERS

# Kunci enkripsi secret tersimpan (AES-256-GCM). Harus BERBEDA dari AUTH_SECRET.
# Kehilangan kunci ini berarti kehilangan semua secret tersimpan.
SECRETS_ENCRYPTION_KEY=CHANGE_ME_SEPARATE_ENCRYPTION_KEY

# Token setup akun pertama (sekali pakai). Setelah setup selesai, token ini tidak berlaku lagi.
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN_SINGLE_USE

# Mode registrasi: closed berarti registrasi publik tertutup (default MVP single-user).
REGISTRATION_MODE=closed

# URL publik aplikasi. Nilai yang sama dengan PUBLIC_BASE_URL di .env.example root.
PUBLIC_BASE_URL=http://localhost:3000

# True hanya bila server berada di belakang reverse proxy tepercaya (mis. Caddy).
TRUST_PROXY=false

# Verifikasi JWT Cloudflare Access di origin (fail closed: bila tidak di-set, request ditolak).
CF_ACCESS_AUD=CHANGE_ME_ACCESS_AUDIENCE
CF_ACCESS_TEAM_DOMAIN=https://CHANGE_ME.cloudflareaccess.com

# Token layanan internal untuk klien mesin (mis. integrasi Muse AI di masa depan). Bukan token pengguna.
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN

# Jalankan migrasi database saat start (default true).
MIGRATE_ON_START=true

# Nama lama untuk konsep WORKSPACE_ROOT di draf hygiene W09 adalah STORAGE_ROOT,
# dan F10 menyebut konsep yang sama dengan nama WORKSPACE_PATH.
# Kode server Fase 0 hanya membaca WORKSPACE_ROOT. Pakai SATU nama saja (WORKSPACE_ROOT),
# dan jangan mengaktifkan nama lain. Dua baris di bawah ini sengaja dikomentari sebagai catatan penamaan.
# STORAGE_ROOT=/data/workspace
# WORKSPACE_PATH=/data/workspace
