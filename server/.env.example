# Contoh variabel environment untuk API Fastify di server/ (lockfile terpisah, Postgres 17).
# DUMMY SAJA. Jangan isi nilai nyata di file ini.
# Salin ke server/.env untuk pemakaian lokal, lalu isi nilai nyata di server/.env (tidak pernah di-commit).
# Bagian A dibaca kode server (endpoint health + fondasi backend Fase 1).
# Variabel Bagian B dibaca tooling lain (deploy/migrasi), bukan oleh loadConfig server.
# Perilaku start: boot DITOLAK bila PORT tidak valid, REGISTRATION_MODE atau
# CF_ACCESS_ENABLED tidak dikenal, CF_ACCESS_ENABLED=true tanpa CF_ACCESS_AUD atau
# CF_ACCESS_TEAM_DOMAIN, Access nonaktif di luar dev localhost, atau
# COOKIE_SECURE=false di luar dev localhost. Pesan boot hanya menyebut nama variabel.
# DATABASE_URL atau WORKSPACE_ROOT yang hilang tidak menggagalkan start;
# server tetap start, live menjawab 200, dan ready menjawab 503.

# Bagian A: dibaca kode server.

NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# Timeout health dalam milidetik. Batas total harus lebih besar dari timeout per check.
HEALTH_CHECK_TIMEOUT_MS=2000
HEALTH_OVERALL_TIMEOUT_MS=5000

# Koneksi Postgres 17. User, password, dan nama database harus cocok dengan infra/.env
# pada deployment yang sama. Nilai di bawah ini dummy; ganti seluruhnya di server/.env.
# Bila tidak di-set, ready menjawab 503 (db: DB_NOT_CONFIGURED).
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/CHANGE_ME_DB

# Root penyimpanan file workspace di disk server. Harus path absolut dan bukan /.
# Nama kanonis: WORKSPACE_ROOT, tanpa fallback ke nama lain.
# Bila tidak di-set, ready menjawab 503 (workspace: WORKSPACE_NOT_CONFIGURED).
WORKSPACE_ROOT=/CHANGE_ME/workspace

# Batas ukuran body JSON global dalam byte. Default 1048576 (1 MB), maks 104857600.
# Batas per endpoint yang lebih kecil (misal transaksi) ditegakkan handler-nya.
BODY_LIMIT_BYTES=1048576

# Secret server. Minimal 32 karakter acak. Hanya keberadaan dan panjangnya yang
# dicatat config; nilainya tidak pernah disimpan di config atau log.
# Jangan pernah diganti setelah layanan berjalan tanpa prosedur rotasi.
AUTH_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARACTERS

# Kunci enkripsi secret tersimpan (AES-256-GCM). Nama kanonis: ENCRYPTION_KEY.
# Harus BERBEDA dari AUTH_SECRET. Kehilangan kunci ini berarti kehilangan
# semua secret tersimpan. Nama lama SECRETS_ENCRYPTION_KEY masih diterima
# sebagai alias, tetapi jangan dipakai untuk deployment baru.
ENCRYPTION_KEY=CHANGE_ME_SEPARATE_ENCRYPTION_KEY

# Versi kunci enkripsi saat ini (default 1) dan kunci lama yang masih
# dibutuhkan untuk membuka data tersegel lama, untuk rotasi kunci.
# Format kunci lama: daftar "versi=kunci" dipisah koma. Kunci lama
# hanya dipakai untuk dekripsi; penyegelan selalu memakai kunci kini.
ENCRYPTION_KEY_VERSION=1
#ENCRYPTION_PREVIOUS_KEYS=

# Token setup akun pertama. Minimal 32 karakter acak. Wajib ada dan cukup
# panjang saat database belum berisi akun; setelah instalasi selesai, token
# ini tidak lagi memberi hak lewat API. Hanya keberadaan dan panjangnya
# yang dicatat config.
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN_MIN_32_RANDOM_CHARACTERS

# Mode registrasi: closed (default), invitation, atau open. Nilai lain
# menolak boot. Mode open dilarang tanpa keputusan eksplisit + CAPTCHA.
REGISTRATION_MODE=closed

# URL publik aplikasi. Hanya origin-nya yang dipakai (skema + host + port),
# untuk pemeriksaan Origin. Nilai yang sama dengan PUBLIC_BASE_URL di .env.example root.
# Wajib HTTPS untuk deployment remote.
PUBLIC_BASE_URL=http://localhost:3000

# True hanya bila server berada di belakang reverse proxy tepercaya (mis. Caddy)
# yang tidak dapat di-bypass. Memengaruhi asal IP klien untuk rate limit dan audit.
TRUST_PROXY=false

# Cookie sesi memakai flag Secure bila true (default). False hanya diizinkan
# bila NODE_ENV=development DAN origin adalah localhost; di luar itu boot ditolak.
COOKIE_SECURE=true

# Verifikasi JWT Cloudflare Access di origin. True di deployment muse-2;
# false hanya untuk dev lokal. Nilai lain menolak boot.
CF_ACCESS_ENABLED=false

# Domain team Access (tanpa skema), dipakai membentuk iss dan URL JWKS.
# Wajib bila CF_ACCESS_ENABLED=true; bila tidak di-set, boot ditolak.
CF_ACCESS_TEAM_DOMAIN=CHANGE_ME.cloudflareaccess.com

# Audience aplikasi Access dari dashboard. Wajib bila CF_ACCESS_ENABLED=true,
# tanpa default; bila tidak di-set, boot ditolak.
CF_ACCESS_AUD=CHANGE_ME_ACCESS_AUDIENCE

# Audience untuk JWT service token, bila terbukti berbeda dari CF_ACCESS_AUD.
# Opsional; bila di-set, aud yang diterima adalah salah satu dari keduanya.
CF_ACCESS_SERVICE_AUD=

# TTL cache JWKS dalam detik. Default 3600.
CF_ACCESS_JWKS_CACHE_TTL_SECONDS=3600

# Audience JWT non-browser (jalur token agen Fase 3a). Tidak ada token Bearer
# yang diterima di MVP; variabel ini hanya dicatat config untuk pemakaian kelak.
JWT_AUDIENCE=

# Bagian B: dibaca tooling lain, bukan loadConfig server.

# Jalankan migrasi database saat start (default true). Dibaca tooling deploy/migrasi.
MIGRATE_ON_START=true

# Nama lama untuk konsep WORKSPACE_ROOT di draf hygiene W09 adalah STORAGE_ROOT,
# dan F10 menyebut konsep yang sama dengan nama WORKSPACE_PATH.
# Kode server hanya membaca WORKSPACE_ROOT. Pakai SATU nama saja (WORKSPACE_ROOT),
# dan jangan mengaktifkan nama lain. Dua baris di bawah ini sengaja dikomentari sebagai catatan penamaan.
# STORAGE_ROOT=/data/workspace
# WORKSPACE_PATH=/data/workspace

# Sengaja TIDAK ada token layanan internal di file ini: tidak ada jalur Bearer
# di MVP (kontrak-api-kanonis.md seksi 1.2). Token agen adalah Fase 3a.
