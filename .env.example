# Contoh variabel environment untuk build web fork NoteGen.
# DUMMY SAJA. Jangan isi nilai nyata di file ini.
# Salin ke .env untuk pemakaian lokal, lalu isi nilai nyata di .env (file .env tidak pernah di-commit).

# Lingkungan Node: development untuk lokal, production untuk deploy.
NODE_ENV=development

# Port dan bind untuk server web standalone Next.js.
# Di container, HOSTNAME wajib 0.0.0.0 agar Caddy dalam jaringan compose dapat menjangkau service ini.
PORT=3000
HOSTNAME=0.0.0.0

# Target build fork: web (standalone) atau desktop (export, jalur Tauri upstream).
NOTEGEN_BUILD_TARGET=web

# Mode web: 1 berarti jalur web aktif (guard boot, shim web). Bila tidak di-set, defaultnya mati.
NEXT_PUBLIC_WEB_MODE=1

# URL publik aplikasi untuk tautan dan metadata. Nilai yang sama dipakai server (lihat server/.env.example).
# Contoh lokal di bawah ini bukan nilai produksi.
PUBLIC_BASE_URL=http://localhost:3000

# Sengaja TIDAK ada NEXT_PUBLIC_API_BASE_URL: browser memanggil API lewat path relatif /api/*
# dan Caddy me-route ke service API (same-origin). Jangan menambah variabel ini tanpa keputusan desain.
# Sengaja TIDAK ada secret di file ini: secret hanya ada sebagai placeholder di server/.env.example
# dan infra/.env.example.
