# testing
/coverage
*.test.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Android signing keys
*.keystore
*.jks
android-app.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
docs/.vitepress/dist
docs/.vitepress/cache

.idea

# Exclude all markdown files in root directory except README.md
/*.md
!README.md
!README.zh-CN.md

# backup files
*.backup
.backup

# worktrees
.worktrees

# Local Remotion video workspace
/remotion/*

# Generated browser workers
/public/plugin-runtime.js
/public/markdown-lexer.js

# Fork web: data runtime dan artefak build server (jangan commit database dev atau hasil build)
server/data/
server/dist/
server/coverage/
infra/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Fork web: file env contoh BOLEH di-commit (nilai dummy saja, lihat seksi 2 dokumen hygiene)
!.env.example
!server/.env.example
!infra/.env.example

# Fork web: dokumen fork di root BOLEH di-commit (lihat seksi 3 dokumen hygiene)
!FORK.md

# Fork web: runbook infra BOLEH di-commit (pola docs/ di atas meng-ignore-nya)
!infra/docs/
!infra/docs/**

# Fork web: berkas test TypeScript/JavaScript BOLEH di-commit (pengecualian atas *.test.* di atas)
!*.test.ts
!*.test.tsx
!*.test.mts
!*.test.mjs
!*.test.js
!*.test.jsx
!*.test.cjs
