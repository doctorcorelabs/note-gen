# Contoh variabel environment untuk compose di infra/ (Postgres 17).
# DUMMY SAJA. Jangan isi nilai nyata di file ini.
# Salin ke infra/.env untuk pemakaian lokal, lalu isi nilai nyata di infra/.env (tidak pernah di-commit).
# Variabel ini hanya dibaca compose; aplikasi tidak membacanya langsung.
# DATABASE_URL di server/.env harus memakai user, password, dan nama database yang sama
# pada deployment yang sama.

POSTGRES_DB=CHANGE_ME_DB
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
