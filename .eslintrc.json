{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@next/next/no-img-element": "off",
    "react-hooks/exhaustive-deps": "off",
    "@typescript-eslint/no-explicit-any": "off"
  },
  "ignorePatterns": [
    "docs/**"
  ],
  "overrides": [
    {
      "excludedFiles": [
        "src/lib/platform/**/*"
      ],
      "files": [
        "src/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@tauri-apps/*",
                  "tauri-plugin-clipboard-api"
                ],
                "message": "Do not import Tauri APIs outside src/lib/platform/. Use the adapter from @/lib/platform instead (AD-07)."
              },
              {
                "group": [
                  "**/lib/platform/*/*.tauri",
                  "**/lib/platform/*/*.web",
                  "@/lib/platform/*/*.tauri",
                  "@/lib/platform/*/*.web",
                  "**/*.tauri",
                  "**/*.web"
                ],
                "message": "Do not import adapter implementations directly. Use the adapter from @/lib/platform (registry) instead."
              }
            ]
          }
        ]
      }
    },
    {
      "excludedFiles": [
        "src/lib/platform/**/*.tauri.ts"
      ],
      "files": [
        "src/lib/platform/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@tauri-apps/*"
                ],
                "message": "Only *.tauri.ts files may import @tauri-apps/*."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/platform/**/*.tauri.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/lib/platform/*/*.web",
                  "@/lib/platform/*/*.web",
                  "**/*.web"
                ],
                "message": "A *.tauri.ts implementation must never import a *.web.ts implementation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/platform/**/*.web.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/lib/platform/*/*.tauri",
                  "@/lib/platform/*/*.tauri",
                  "**/*.tauri"
                ],
                "message": "A *.web.ts implementation must never import a *.tauri.ts implementation."
              },
              {
                "group": [
                  "@tauri-apps/*"
                ],
                "message": "Only *.tauri.ts files may import @tauri-apps/*."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "Literal[value='terminal.open']",
            "message": "Forbidden literal: terminal execution is removed permanently from the web fork (AD-14, AD-109, W4-SEC). Do not name this permission in src/; assemble the name at runtime in a test only when a regression test must reference it, following src/lib/platform/invoke/router.spec.ts."
          },
          {
            "selector": "Literal[value=/^plugin_terminal_/]",
            "message": "Forbidden literal: terminal backend commands are removed permanently from the web fork (AD-14, AD-109, W4-SEC). Do not name a plugin_terminal_* command in src/; assemble the name at runtime in a test only when a regression test must reference it, following src/lib/platform/invoke/router.spec.ts."
          }
        ]
      }
    }
  ]
}
